
@page
@model IndexModel
@{
    ViewData["Title"] = "Sistem Inventori Dinamik";
}

<div class="container mt-5">
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">📋 Sistem Inventori Aset ICT (Dinamik)</h3>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Nama / Model Aset</label>
                    <input type="text" asp-for="NamaAset" class="form-control" placeholder="Contoh: MacBook Air M2" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Nombor Siri / Tag Aset</label>
                    <input type="text" asp-for="NoSiriAset" class="form-control" placeholder="Contoh: KPM/ICT/2026/010" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Kategori</label>
                    <select asp-for="KategoriAset" class="form-select">
                        <option>Komputer Riba / PC</option>
                        <option>Peranti Rangkaian</option>
                        <option>Pencetak & Pengimbas</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-success w-100">Simpan Maklumat Aset</button>
            </form>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">📦 Senarai Semasa Aset ICT Terdaftar</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>No.</th>
                            <th>No. Siri / Tag</th>
                            <th>Nama / Model Aset</th>
                            <th>Kategori</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var aset in IndexModel.SenaraiAset)
                        {
                            <tr>
                                <td>@i</td>
                                <td><code>@aset.NoSiri</code></td>
                                <td>@aset.Nama</td>
                                <td>@aset.Kategori</td>
                                <td><span class="badge bg-success">@aset.Status</span></td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
