@model List<MacApp.Models.Item>
@{
    ViewData["Title"] = "MacApp Interactive Dashboard";
    var totalItems = Model.Count;
    var outOfStock = Model.Count(i => !i.IsAvailable);
    var totalValue = Model.Sum(i => i.Price * i.Quantity);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-cpu"></i> MacApp Dashboard Inventori</h2>
        <span class="badge bg-secondary p-2">Status Server: Aktif di Docker 🚀</span>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow-sm">
                <div class="card-body">
                    <h6>Jumlah Jenis Produk</h6>
                    <h2>@totalItems Jenis</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-danger text-white shadow-sm">
                <div class="card-body">
                    <h6>Produk Habis Stok</h6>
                    <h2>@outOfStock Produk</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body">
                    <h6>Jumlah Nilai Nilai Stok</h6>
                    <h2>RM @totalValue.ToString("N2")</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Tambah Produk Baru</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddItem" method="post">
                        <div class="mb-3">
                            <label class="form-label">Nama Barang</label>
                            <input type="text" name="Name" class="form-placeholder form-control" required placeholder="Cth: Magic Mouse" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Kategori</label>
                            <select name="Category" class="form-select">
                                <option value="Laptop">Laptop</option>
                                <option value="Telefon">Telefon</option>
                                <option value="Tablet">Tablet</option>
                                <option value="Aksesori">Aksesori</option>
                            </select>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Kuantiti</label>
                                <input type="number" name="Quantity" class="form-control" min="0" value="1" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Harga (RM)</label>
                                <input type="number" name="Price" class="form-control" step="0.01" value="99.00" required />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success w-100"><i class="bi bi-plus-circle"></i> Masukkan ke Inventori</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="mb-3">
                        <input type="text" id="searchBox" class="form-control" placeholder="🔍 Taip di sini untuk tapis nama barang secara live..." onkeyup="filterInventory()" />
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="inventoryTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Nama Produk</th>
                                    <th>Kategori</th>
                                    <th>Harga Seunit</th>
                                    <th>Stok</th>
                                    <th>Status</th>
                                    <th>Tindakan</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-bold item-name">@item.Name</td>
                                        <td><span class="badge bg-light text-dark">@item.Category</span></td>
                                        <td>RM @item.Price.ToString("N2")</td>
                                        <td>@item.Quantity unit</td>
                                        <td>
                                            @if (item.IsAvailable)
                                            {
                                                <span class="badge bg-success-subtle text-success p-2">Tersedia</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger p-2">Habis Stok</span>
                                            }
                                        </td>
                                        <td>
                                            <form asp-action="ToggleStock" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm @(item.IsAvailable ? "btn-outline-danger" : "btn-outline-success")">
                                                    @(item.IsAvailable ? "Set Habis" : "Set Tersedia")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function filterInventory() {
        let input = document.getElementById('searchBox').value.toLowerCase();
        let table = document.getElementById('inventoryTable');
        let rows = table.getElementsByTagName('tr');

        for (let i = 1; i < rows.length; i++) {
            let nameCell = rows[i].querySelector('.item-name');
            if (nameCell) {
                let textValue = nameCell.textContent || nameCell.innerText;
                if (textValue.toLowerCase().indexOf(input) > -1) {
                    rows[i].style.display = "";
                } else {
                    rows[i].style.display = "none";
                }
            }
        }
    }
</script>

